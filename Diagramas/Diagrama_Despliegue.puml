@startuml Diagrama_Despliegue_Cloud_v2
' ==============================================================================
' MAN-DS: APLICACIÓN WEB PARA GESTIÓN DE AUTOESCUELAS
' VISTA FÍSICA / DIAGRAMA DE DESPLIEGUE EN PRODUCCIÓN CLOUD (PERFIL: deploy)
' ==============================================================================

top to bottom direction

skinparam nodeStyle rectangle
skinparam roundCorner 8
skinparam defaultFontName "Inter", "Segoe UI", "sans-serif"
skinparam defaultFontSize 10
skinparam shadowing false
skinparam wrapWidth 250
skinparam nodesep 42
skinparam ranksep 46

' Paleta de colores corporativa
skinparam stereotypeFontStyle plain

skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
  StereotypeFontStyle plain
}

skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
  FontColor #1E293B
}

skinparam database {
  BackgroundColor #FAF5FF
  BorderColor #7C3AED
  FontColor #4C1D95
}

' ------------------------------------------------------------------------------
' 1. ACCESO DE CLIENTE Y MONITORIZACIÓN (NIVEL SUPERIOR)
' ------------------------------------------------------------------------------
node "**Dispositivo de Usuario**" <<device>> as DispositivoCliente #EFF6FF {
  node "**Navegador Web**" <<executionEnvironment>> as NavegadorCliente #DBEAFE {
    artifact "**Interfaz SSR (HTML-over-the-wire)**\n• Documentos HTML5 renderizados en servidor\n• Fragmentos reactivos htmx.min.js\n• tailwind.min.css + JS ES6+ (caché 7 días)" as InterfazWeb #BFDBFE
  }
}

node "**UptimeRobot Cloud**" <<cloud>> as NodoMonitor #FEFCE8 {
  node "**Monitor de Disponibilidad**\n(Keep-Alive)" <<executionEnvironment>> as UptimeMonitor #FEF08A
}

DispositivoCliente -[hidden]right- NodoMonitor

' ------------------------------------------------------------------------------
' 2. SERVIDOR DE APLICACIONES (PAAS CLOUD - RENDER)
' ------------------------------------------------------------------------------
node "**Plataforma PaaS Cloud Render (Región Frankfurt, UE)**" <<cloud>> as NodoRender #F0FDF4 {
  node "**Proxy Inverso / Balanceador TLS**" <<executionEnvironment>> as ProxyRender #DCFCE7

  node "**Instancia Contenerizada (Dockerfile con 512 MB RAM)**\neclipse-temurin:21-jre-alpine (Alpine Linux)" <<executionEnvironment>> as ContenedorApp #DCFCE7 {
    node "**JVM OpenJDK 21 + Apache Tomcat Embebido**" <<executionEnvironment>> as RuntimeJVM #BBF7D0 {
      artifact "**app.jar (ManDS · Spring Boot 4.1.2)**\n• Seguridad Perimetral (Spring Security, RBAC, CSRF, JSESSIONID)\n• Módulos Funcionales (Package-by-Feature)\n• Motor SSR (Thymeleaf cache=true) y Compresión GZIP\n• Pool de Conexiones HikariCP (máx. 5 conexiones)" as AppSpring #FFFFFF
    }
  }

  ProxyRender -down-> RuntimeJVM : " HTTP interno (Puerto 8080)\n[Cabeceras X-Forwarded-*]"
}

' ------------------------------------------------------------------------------
' 3. PERSISTENCIA Y SERVICIOS EXTERNOS CLOUD (NIVEL INFERIOR)
' ------------------------------------------------------------------------------
node "**Supabase Cloud (BaaS)**" <<cloud>> as NodoSupabase #FAF5FF {
  node "**Connection Pooler IPv4**" <<executionEnvironment>> as PoolerSupabase #EDE9FE
  database "PostgreSQL 16" <<executionEnvironment>> as MotorPostgres #EDE9FE {
    artifact "**Esquema Relacional ManDS**\n• Integridad referencial y restricciones únicas\n• Transacciones ACID e índices de consulta" as EsquemaBD #DDD6FE
  }
  PoolerSupabase -down-> MotorPostgres : " Pool de sesiones"
}

node "**Stripe Cloud**" <<cloud>> as NodoStripe #F8FAFC {
  node "**Stripe Checkout & Webhooks API**" <<executionEnvironment>> as ServicioStripe #E2E8F0
}

node "**Brevo Cloud**" <<cloud>> as NodoBrevo #F8FAFC {
  node "**Brevo REST API v3**" <<executionEnvironment>> as ServicioBrevo #E2E8F0
}

NodoSupabase -[hidden]right- NodoStripe
NodoStripe -[hidden]right- NodoBrevo

' ------------------------------------------------------------------------------
' COMUNICACIONES Y PROTOCOLOS DE RED
' ------------------------------------------------------------------------------
InterfazWeb -down-> ProxyRender : " HTTPS / TLS (Puerto 443)\n[Vistas HTML y fragmentos HTMX]"
UptimeMonitor -down-> ProxyRender : " HTTPS GET /ping (Puerto 443)\n[Cada 5 min | evita suspensión]"

AppSpring -down-> PoolerSupabase : " PostgreSQL JDBC sobre SSL (Puerto 5432)\n[sslmode=require, tcpKeepAlive, batching]"

AppSpring -down-> ServicioStripe : " HTTPS (Puerto 443)\n[Sesiones Checkout PCI-DSS]"
ServicioStripe -up-> ProxyRender : " Webhooks HTTPS (Puerto 443)\n[Firma Stripe-Signature]"


AppSpring -down-> ServicioBrevo : " HTTPS REST API v3 (Puerto 443)\n[HttpClient nativo asíncrono]"

@enduml