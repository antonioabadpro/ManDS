@startuml Diagrama_Despliegue_Cloud_v5
' ==============================================================================
' MAN-DS: APLICACIÓN WEB PARA GESTIÓN DE AUTOESCUELAS
' VISTA FÍSICA / DIAGRAMA DE DESPLIEGUE EN PRODUCCIÓN CLOUD (PERFIL: deploy)
' ==============================================================================
skinparam dpi 300
top to bottom direction

skinparam nodeStyle rectangle
skinparam roundCorner 8
skinparam defaultFontName "Inter", "Segoe UI", "sans-serif"
skinparam defaultFontSize 10
skinparam shadowing false
skinparam wrapWidth 240
skinparam nodesep 46
skinparam ranksep 52

skinparam stereotypeFontStyle plain

skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
  StereotypeFontStyle plain
}

skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
  FontColor #1E293B
}

skinparam database {
  BackgroundColor #FAF5FF
  BorderColor #7C3AED
  FontColor #4C1D95
}

' ------------------------------------------------------------------------------
' 1. ACCESO DE CLIENTE Y MONITORIZACIÓN (NIVEL SUPERIOR)
' ------------------------------------------------------------------------------
together {
  node "**Dispositivo de Usuario · Navegador Web**" <<device>> as DispositivoCliente #EFF6FF {
    artifact "**Interfaz SSR (HTML-over-the-wire)**\n• Documentos HTML5 renderizados en servidor\n• Fragmentos reactivos htmx.min.js\n• tailwind.min.css + JS ES6+ (caché 7 días)" as InterfazWeb #BFDBFE
  }

  node "**UptimeRobot Cloud**\nMonitor de Disponibilidad (Keep-Alive)" <<executionEnvironment>> as NodoMonitor #FEF9C3

  DispositivoCliente -[hidden]right- NodoMonitor
}

' ------------------------------------------------------------------------------
' 2. SERVIDOR DE APLICACIONES (PAAS CLOUD - RENDER)
' ------------------------------------------------------------------------------
node "**Plataforma PaaS Cloud Render (Región Frankfurt, UE)**" <<executionEnvironment>> as NodoRender #F0FDF4 {
  node "**Proxy Inverso / Balanceador TLS**" <<executionEnvironment>> as ProxyRender #DCFCE7

  node "**Contenedor Docker (Dockerfile · 512 MB RAM)**\neclipse-temurin:21-jre-alpine · JVM OpenJDK 21 + Tomcat Embebido" <<executionEnvironment>> as ContenedorApp #BBF7D0 {
    artifact "**app.jar (ManDS · Spring Boot 4.1.2)**\n• Perfil activo: deploy\n• Seguridad Perimetral (Spring Security, RBAC, CSRF, JSESSIONID)\n• Módulos Funcionales (Package-by-Feature)\n• Motor SSR (Thymeleaf cache=true) y Compresión GZIP\n• Pool de Conexiones HikariCP (máx. 5 conexiones)" as AppSpring #FFFFFF
  }

  ProxyRender -down- ContenedorApp : " HTTP interno (:8080)\n[Cabeceras X-Forwarded-*]"
}

' ------------------------------------------------------------------------------
' 3. PERSISTENCIA Y SERVICIOS EXTERNOS CLOUD (NIVEL INFERIOR)
' ------------------------------------------------------------------------------
together {
  node "**Supabase Cloud (BaaS)**" <<executionEnvironment>> as NodoSupabase #FAF5FF {
    node "**Connection Pooler IPv4**" <<executionEnvironment>> as PoolerSupabase #EDE9FE
    database "PostgreSQL 16" <<executionEnvironment>> as MotorPostgres #EDE9FE {
      artifact "**Esquema Relacional ManDS**\n• Integridad referencial y restricciones únicas\n• Transacciones ACID e índices de consulta" as EsquemaBD #DDD6FE
    }
    PoolerSupabase -down- MotorPostgres : " Pool de sesiones"
  }

  node "**Brevo Cloud**\nBrevo REST API v3" <<executionEnvironment>> as NodoBrevo #F1F5F9

  node "**Stripe Cloud**\nStripe Checkout & Webhooks API" <<executionEnvironment>> as NodoStripe #F1F5F9

  NodoSupabase -[hidden]right- NodoBrevo
  NodoBrevo -[hidden]right- NodoStripe
}

' ------------------------------------------------------------------------------
' RUTAS DE COMUNICACIÓN ENTRE NODOS (UML 2.5 COMMUNICATION PATHS)
' ------------------------------------------------------------------------------
DispositivoCliente -down- ProxyRender : " HTTPS / TLS (:443)\n[Vistas HTML y HTMX]"
NodoMonitor -down- ProxyRender : " HTTPS GET /ping (:443)\n[Cada 5 min]"

ContenedorApp -down- NodoSupabase : " JDBC SSL (:5432)\n[sslmode=require, batching]"
ContenedorApp -down- NodoBrevo : " HTTPS REST v3 (:443)\n[HttpClient asíncrono]"
ContenedorApp -down- NodoStripe : " HTTPS (:443)\n[Checkout PCI-DSS]"
ProxyRender -down- NodoStripe : " Webhooks HTTPS (:443)\n[Stripe → Proxy · Firma HMAC]"

@enduml