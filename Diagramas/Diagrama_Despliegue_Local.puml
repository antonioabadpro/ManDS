@startuml Diagrama_Despliegue_Local_v5
' ==============================================================================
' MAN-DS: APLICACIÓN WEB PARA GESTIÓN DE AUTOESCUELAS
' VISTA FÍSICA / ENTORNO LOCAL CONTENERIZADO (DOCKER COMPOSE · PERFIL: docker)
' ==============================================================================
skinparam dpi 300
top to bottom direction

skinparam nodeStyle rectangle
skinparam roundCorner 8
skinparam defaultFontName "Inter", "Segoe UI", "sans-serif"
skinparam defaultFontSize 10
skinparam shadowing false
skinparam wrapWidth 230
skinparam nodesep 85
skinparam ranksep 52

skinparam stereotypeFontStyle plain

skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
  StereotypeFontStyle plain
}

skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
  FontColor #1E293B
}

skinparam database {
  BackgroundColor #FAF5FF
  BorderColor #7C3AED
  FontColor #4C1D95
}

' ------------------------------------------------------------------------------
' HOST FÍSICO LOCAL (ESTACIÓN DE TRABAJO)
' ------------------------------------------------------------------------------
node "**Estación de Trabajo Local (Host)**" <<device>> as HostLocal #F8FAFC {

  ' 1. CLIENTE WEB EN EL HOST
  node "**Navegador Web**" <<executionEnvironment>> as NavegadorLocal #DBEAFE {
    artifact "**Interfaz Web ManDS**\n(http://localhost:8080)" as WebLocal #BFDBFE
    artifact "**Bandeja Simulada Mailpit UI**\n(http://localhost:8025)" as MailpitUI #FEF08A
    WebLocal -[hidden]right- MailpitUI
  }

  ' 2. ENTORNO DE EJECUCIÓN DOCKER ENGINE
  node "**Docker Engine / Docker Desktop (Red bridge: mands_network)**" <<executionEnvironment>> as DockerEngine #F1F5F9 {

    ' FILA SUPERIOR: APLICACIÓN Y CORREO SIMULADO EN PARALELO
    node "**Contenedor mands_app**\nantonioabadpro/mands:latest · eclipse-temurin:21-jre-alpine\nJVM OpenJDK 21 + Apache Tomcat Embebido" <<executionEnvironment>> as ContenedorApp #DCFCE7 {
      artifact "**app.jar (ManDS · Spring Boot 4.1.2)**\n• Perfil activo: docker (Puerto 8080:8080)\n• ddl-auto=create-drop + carga data.sql\n• thymeleaf.cache=false\n• Stripe en modo simulación (o test si existe .env)" as AppSpring #FFFFFF
    }

    node "**Contenedor mailpit_tfg**\naxllent/mailpit:latest\nServidor Mailpit (SMTP :1025 | Web UI :8025)" <<executionEnvironment>> as ContenedorMailpit #FEF9C3

    ContenedorApp -[hidden]right- ContenedorMailpit

    ' FILA INFERIOR: BASE DE DATOS Y VOLUMEN BAJO LA APLICACIÓN
    node "**Contenedor postgres_tfg**\npostgres:16-alpine (Puerto 5432:5432)" <<executionEnvironment>> as ContenedorPg #FAF5FF {
      database "PostgreSQL 16" <<executionEnvironment>> as MotorPg #EDE9FE {
        artifact "**Base de Datos tfg_db**\n• Esquema relacional ManDS\n• Poblado automático con data.sql" as EsquemaLocal #DDD6FE
      }
      artifact "**Volumen Persistente pgdata_tfg**\n(/var/lib/postgresql/data)" as VolumenPg #F3E8FF
      MotorPg -[hidden]right- VolumenPg
      MotorPg .right.> VolumenPg : " <<use>>\nMontaje"
    }
  }
}

' ------------------------------------------------------------------------------
' RUTAS DE COMUNICACIÓN ENTRE NODOS (LOCALHOST Y RED BRIDGE)
' ------------------------------------------------------------------------------
WebLocal -down- ContenedorApp : " HTTP (:8080 → 8080)\n[HTML y fragmentos HTMX]"
MailpitUI -down- ContenedorMailpit : " HTTP (:8025 → 8025)\n[Inspección de correos]"

AppSpring -right- ContenedorMailpit : " SMTP\nmailpit:1025\n[Red bridge]"
ContenedorApp -down- ContenedorPg : " JDBC PostgreSQL (postgres:5432)\n[Red bridge mands_network]"

@enduml