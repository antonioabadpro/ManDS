@startuml Diagrama_ER_v18
' --- AJUSTES VISUALES (linetype polyline, bordes ceñidos, 6 entidades en paralelo, Enums compactos A4) ---
scale max 1200 width
skinparam linetype polyline
skinparam shadowing false
skinparam defaultFontSize 11
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam packageFontSize 11
skinparam arrowFontSize 10
skinparam nodesep 50
skinparam ranksep 120
skinparam padding 3
skinparam packageStyle rectangle
hide empty members

<style>
package {
  Padding 8
}
</style>

' --- 1. AUTENTICACIÓN (Tokens de verificación) ---
package "Autenticación" {
  class TokenVerificacion {
    - id: Long
    - token: String
    - fechaExpiracion: LocalDateTime
    - usado: boolean
    - fechaCreacion: LocalDateTime
    - persona: Persona
    + isExpirado(): boolean
    + isValido(): boolean
    + isUsado(): boolean
    + marcarComoUsado(): void
  }
}

' --- 2. USUARIOS (Capa Superior) ---
package "Usuarios" {
  abstract class Persona {
    - id: Long
    - nombre: String
    - apellidos: String
    - dni: String
    - fechaNacimiento: LocalDate
    - nombreUsuario: String
    - correo: String
    - password: String
    - telefono: String
    - direccion: String
    - estado: EstadoUsuario
    + actualizarPassword(passwordCodificada: String): void
    + esMayorDeEdad(): boolean
    + {abstract} getRol(): Rol
  }

  class Administrador {
    + getRol(): Rol
  }

  class Profesor {
    - fechaContratacion: LocalDate
    - turno: TipoTurno
    - listaAlumnos: List<Alumno>
    - listaClasesPracticas: List<ClasePractica>
    - listaSolicitudesExamen: List<SolicitudExamen>
    - listaTiposCarnet: List<TipoCarnet>
    - vehiculo: Vehiculo
    + getRol(): Rol
  }

  class Alumno {
    - historialClasesPracticas: List<ClasePractica>
    - historialExamenes: List<Examen>
    - historialMatriculas: List<Matricula>
    - listaSolicitudesExamen: List<SolicitudExamen>
    - profesor: Profesor
    + getRol(): Rol
  }
}

' --- 3. AUTOESCUELA (Capa Central) ---
package "Autoescuela" {
  class Vehiculo {
    - id: Long
    - matricula: String
    - marca: String
    - modelo: String
    - color: String
    - km: Long
    - cv: Integer
    - anio: Integer
    - tipoCombustible: TipoCombustible
    - cajaCambios: TipoCambio
    - fechaUltimaRevision: LocalDate
    - fechaProximaRevision: LocalDate
    - estado: EstadoVehiculo
    - tipoPermiso: TipoCarnet
    - profesor: Profesor
    - incidencias: List<IncidenciaVehiculo>
  }

  class IncidenciaVehiculo {
    - id: Long
    - fechaHora: LocalDateTime
    - descripcion: String
    - estado: EstadoIncidencia
    - vehiculo: Vehiculo
    - profesor: Profesor
  }

  class Matricula {
    - id: Long
    - estaActiva: Boolean
    - permisoCarnet: TipoCarnet
    - convocatorias: Integer
    - saldoClases: Integer
    - convocatoriasGastadas: Integer
    - precio: Float
    - fechaMatriculacion: LocalDate
    - tipo: TipoMatricula
    - modalidad: ModalidadMatricula
    - alumno: Alumno
    - listaSolicitudesExamen: List<SolicitudExamen>
    + tieneConvocatoriasAgotadas(): boolean
  }

  class ClasePractica {
    - id: Long
    - fechaHora: LocalDateTime
    - duracion: Integer
    - puntoRecogida: String
    - kmInicio: Long
    - kmFin: Long
    - observaciones: String
    - motivoCancelacion: String
    - estadoClase: EstadoClase
    - isCanceladaPorProfesor: Boolean
    - isCancelacionJornada: Boolean
    - alumno: Alumno
    - profesor: Profesor
  }

  class FechaExamen {
    - id: Long
    - mes: LocalDate
    - fechaHora1: LocalDateTime
    - fechaHora2: LocalDateTime
  }

  class CupoExamen {
    - id: Long
    - mes: LocalDate
    - tipoPermiso: TipoCarnet
    - cupoTeorico: Integer
    - cupoPractico: Integer
  }

  class SolicitudExamen {
    - id: Long
    - fechaHora: LocalDateTime
    - estado: EstadoSolicitud
    - tipo: TipoExamen
    - comentarioJustificacion: String
    - alumno: Alumno
    - profesor: Profesor
    - matricula: Matricula
    - examen: Examen
  }

  class Examen {
    - id: Long
    - esApto: Boolean
    - fechaHora: LocalDateTime
    - duracion: Integer
    - tipo: TipoExamen
    - alumno: Alumno
    - solicitudExamen: SolicitudExamen
  }
}

' --- 4. ENUMS (Rejilla compacta de 6 columnas alineada bajo Autoescuela) ---
package "Enums" {
  enum TipoCarnet {
    PERMISO_AM, PERMISO_A1, PERMISO_A2, PERMISO_A
    PERMISO_B, PERMISO_B_E, PERMISO_B1, PERMISO_C
    PERMISO_C_E, PERMISO_D, PERMISO_D_E, PERMISO_LVA
  }
  enum EstadoVehiculo {
    DISPONIBLE
    OCUPADO
    MANTENIMIENTO
    INACTIVO
  }
  enum TipoCombustible {
    GASOLINA
    DIESEL
    ELECTRICO
    HIBRIDO
  }
  enum EstadoSolicitud {
    PENDIENTE
    ACEPTADA
    RECHAZADA
  }
  enum EstadoIncidencia {
    PENDIENTE
    EN_PROCESO
    RESUELTA
  }
  enum EstadoClase {
    RECIBIDA
    PENDIENTE
    CANCELADA
  }
  enum EstadoUsuario {
    ACTIVO
    INACTIVO
  }
  enum TipoCambio {
    MANUAL
    AUTOMATICO
  }
  enum ModalidadMatricula {
    TEORICO_PRACTICA
    PRACTICA
  }
  enum Rol {
    ADMIN
    PROFESOR
    ALUMNO
  }
  enum TipoTurno {
    MATINAL
    TARDE
  }
  enum TipoMatricula {
    NUEVA
    RENOVACION
  }
  enum TipoExamen {
    TEORICO
    PRACTICO
  }
}

' --- 5. RELACIONES Y DISPOSICIÓN PLANAR ---

' Alineación superior: Persona centrado sobre Profesor (centro de sus hijos)
Persona -[hidden]down-> Profesor
Administrador -[hidden]right-> Profesor
Profesor -[hidden]right-> Alumno

' Herencia
Persona <|-down- Administrador
Persona <|-down- Profesor
Persona <|-down- Alumno

' Relación de autenticación (ancla Autenticación a la derecha de Alumno con nodesep 50 para liberar 0..* de los bordes)
Alumno -[hidden]right-> TokenVerificacion
Persona "1" -down-> "0..*" TokenVerificacion : posee >

' Fila paralela principal dentro de Autoescuela (sin cruces ni saltos sobre cajas):
' Vehiculo -> IncidenciaVehiculo | ClasePractica | Matricula -> SolicitudExamen -> Examen
Vehiculo "1" -right-> "0..*" IncidenciaVehiculo : sufre >\n 
IncidenciaVehiculo -[hidden]right-> ClasePractica
ClasePractica -[hidden]right-> Matricula
Matricula "1" -right-> "0..*" SolicitudExamen : genera >\n 
SolicitudExamen "1" -right-> "0..1" Examen : deriva en >\n 

' Relación horizontal entre profesores y alumnos
Profesor "0..1" -right-> "0..*" Alumno : enseña a >\n 

' Relaciones verticales hacia la fila paralela de Autoescuela (ordenadas izquierda -> derecha)
Profesor "0..1" -down-> "0..1" Vehiculo : tiene\nasignado >
Profesor "0..1" -down-> "0..*" IncidenciaVehiculo : reporta >
ClasePractica "0..*" -up-> "0..1" Profesor : impartida\npor >
Profesor "0..1" -down-> "0..*" SolicitudExamen : asignado\na >

ClasePractica "0..*" -up-> "0..1" Alumno : recibida\npor >
Alumno "1" -down-> "1..*" Matricula : posee >
Alumno "1" -down-> "0..*" SolicitudExamen : solicita >
Alumno "1" -down-> "0..*" Examen : realiza >

' Fijación de orden izquierdo-derecho (asegura ClasePractica < Matricula < SolicitudExamen < Examen sin saltos superiores)
Administrador -[hidden]down-> Vehiculo
Profesor -[hidden]down-> ClasePractica
Profesor -[hidden]down-> Matricula
Alumno -[hidden]down-> SolicitudExamen
Alumno -[hidden]down-> Examen

' Anclaje inferior de entidades independientes de calendario DGT
ClasePractica -[hidden]down-> FechaExamen
Matricula -[hidden]down-> CupoExamen
FechaExamen -[hidden]right-> CupoExamen

' Alineación de Enums contenida dentro del ancho de Autoescuela (6 columnas, 2 bajo TipoCarnet)
Vehiculo -[hidden]down-> TipoCarnet
FechaExamen -[hidden]down-> TipoCombustible
CupoExamen -[hidden]down-> EstadoSolicitud
SolicitudExamen -[hidden]down-> EstadoClase

TipoCarnet -[hidden]right-> EstadoVehiculo
EstadoVehiculo -[hidden]right-> TipoCombustible
TipoCombustible -[hidden]right-> EstadoSolicitud
EstadoSolicitud -[hidden]right-> EstadoIncidencia
EstadoIncidencia -[hidden]right-> EstadoClase

EstadoUsuario -[hidden]right-> TipoCambio
TipoCambio -[hidden]right-> ModalidadMatricula
ModalidadMatricula -[hidden]right-> Rol
Rol -[hidden]right-> TipoTurno
TipoTurno -[hidden]right-> TipoMatricula
TipoMatricula -[hidden]right-> TipoExamen

TipoCarnet -[hidden]down-> EstadoUsuario
EstadoVehiculo -[hidden]down-> ModalidadMatricula
TipoCombustible -[hidden]down-> Rol
EstadoSolicitud -[hidden]down-> TipoTurno
EstadoIncidencia -[hidden]down-> TipoMatricula
EstadoClase -[hidden]down-> TipoExamen

@enduml
