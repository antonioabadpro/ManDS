@startuml Diagrama_ER_v17
' --- AJUSTES VISUALES ---
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
skinparam padding 5
skinparam packageStyle rectangle

' --- 1. ENUMS (Agrupados a la derecha para no molestar) ---
package "Enums" {
  enum EstadoUsuario {
    - ACTIVO
    - INACTIVO
  }
  enum EstadoVehiculo {
    - DISPONIBLE
    - OCUPADO
    - MANTENIMIENTO
    - INACTIVO
  }
  enum TipoCarnet {
    - PERMISO_AM
    - PERMISO_A1
    - PERMISO_A2
    - PERMISO_A
    - PERMISO_B
    - PERMISO_B_E
    - PERMISO_B1
    - PERMISO_C
    - PERMISO_C_E
    - PERMISO_D
    - PERMISO_D_E
    - PERMISO_LVA
  }
  enum TipoCombustible {
    - GASOLINA
    - DIESEL
    - ELECTRICO
    - HIBRIDO
  }
  enum TipoCambio {
    - MANUAL
    - AUTOMATICO
  }
  enum TipoMatricula {
    - NUEVA
    - RENOVACION
  }
  enum TipoTurno {
    - MATINAL
    - TARDE
  }
  enum ModalidadMatricula {
    - TEORICO_PRACTICA
    - PRACTICA
  }
  enum EstadoSolicitud {
    - PENDIENTE
    - ACEPTADA
    - RECHAZADA
  }
  enum TipoExamen {
    - TEORICO
    - PRACTICO
  }
  enum EstadoIncidencia {
    - PENDIENTE
    - EN_PROCESO
    - RESUELTA
  }
  enum EstadoClase {
    - RECIBIDA
    - PENDIENTE
    - CANCELADA
  }
  enum Rol {
    - ADMIN
    - PROFESOR
    - ALUMNO
  }
}

' --- 2. AUTENTICACIÓN (Tokens de verificación) ---
package "Autenticación" {
  class TokenVerificacion {
    - id: Long
    - token: String
    - fechaExpiracion: LocalDateTime
    - usado: boolean
    - fechaCreacion: LocalDateTime
    - persona: Persona
    + isExpirado(): boolean
    + isValido(): boolean
    + isUsado(): boolean
    + marcarComoUsado(): void
  }
}

' --- 3. USUARIOS (Capa Superior) ---
package "Usuarios" {
  abstract class Persona {
    - id: Long
    - nombre: String
    - apellidos: String
    - dni: String
    - fechaNacimiento: LocalDate
    - nombreUsuario: String
    - correo: String
    - password: String
    - telefono: String
    - direccion: String
    - estado: EstadoUsuario
    + actualizarPassword(passwordCodificada: String): void
    + esMayorDeEdad(): boolean
    + {abstract} getRol(): Rol
  }

  class Administrador {
    + getRol(): Rol
  }

  class Profesor {
    - fechaContratacion: LocalDate
    - turno: TipoTurno
    - listaAlumnos: List<Alumno>
    - listaClasesPracticas: List<ClasePractica>
    - listaSolicitudesExamen: List<SolicitudExamen>
    - listaTiposCarnet: List<TipoCarnet>
    - vehiculo: Vehiculo
    + getRol(): Rol
  }

  class Alumno {
    - historialClasesPracticas: List<ClasePractica>
    - historialExamenes: List<Examen>
    - historialMatriculas: List<Matricula>
    - listaSolicitudesExamen: List<SolicitudExamen>
    - profesor: Profesor
    + getRol(): Rol
  }
}

' --- 4. AUTOESCUELA (Capa Inferior) ---
package "Autoescuela" {
  class Vehiculo {
    - id: Long
    - matricula: String
    - marca: String
    - modelo: String
    - color: String
    - km: Long
    - cv: Integer
    - anio: Integer
    - tipoCombustible: TipoCombustible
    - cajaCambios: TipoCambio
    - fechaUltimaRevision: LocalDate
    - fechaProximaRevision: LocalDate
    - estado: EstadoVehiculo
    - tipoPermiso: TipoCarnet
    - profesor: Profesor
    - incidencias: List<IncidenciaVehiculo>
  }

  class IncidenciaVehiculo {
    - id: Long
    - fechaHora: LocalDateTime
    - descripcion: String
    - estado: EstadoIncidencia
    - vehiculo: Vehiculo
    - profesor: Profesor
  }

  class Matricula {
    - id: Long
    - estaActiva: Boolean
    - permisoCarnet: TipoCarnet
    - convocatorias: Integer
    - saldoClases: Integer
    - convocatoriasGastadas: Integer
    - precio: Float
    - fechaMatriculacion: LocalDate
    - tipo: TipoMatricula
    - modalidad: ModalidadMatricula
    - alumno: Alumno
    - listaSolicitudesExamen: List<SolicitudExamen>
    + tieneConvocatoriasAgotadas(): boolean
  }

  class ClasePractica {
    - id: Long
    - fechaHora: LocalDateTime
    - duracion: Integer
    - puntoRecogida: String
    - kmInicio: Long
    - kmFin: Long
    - observaciones: String
    - motivoCancelacion: String
    - estadoClase: EstadoClase
    - isCanceladaPorProfesor: Boolean
    - isCancelacionJornada: Boolean
    - alumno: Alumno
    - profesor: Profesor
  }

  class FechaExamen {
    - id: Long
    - mes: LocalDate
    - fechaHora1: LocalDateTime
    - fechaHora2: LocalDateTime
  }

  class CupoExamen {
    - id: Long
    - mes: LocalDate
    - tipoPermiso: TipoCarnet
    - cupoTeorico: Integer
    - cupoPractico: Integer
  }

  class SolicitudExamen {
    - id: Long
    - fechaHora: LocalDateTime
    - estado: EstadoSolicitud
    - tipo: TipoExamen
    - comentarioJustificacion: String
    - alumno: Alumno
    - profesor: Profesor
    - matricula: Matricula
    - examen: Examen
  }

  class Examen {
    - id: Long
    - esApto: Boolean
    - fechaHora: LocalDateTime
    - duracion: Integer
    - tipo: TipoExamen
    - alumno: Alumno
    - solicitudExamen: SolicitudExamen
  }
}

' --- 5. RELACIONES (Optimizadas para visualización) ---

' Trucos de alineación para que quede ordenado horizontalmente
Autenticación -[hidden]right-> Usuarios
Usuarios -[hidden]right-> Enums

Administrador -[hidden]right-> Profesor
Profesor -[hidden]right-> Alumno

' Herencia (El flujo cae limpio hacia abajo)
Persona <|-down- Administrador
Persona <|-down- Profesor
Persona <|-down- Alumno

' Relaciones de autenticación
Persona "1" -left-> "0..*" TokenVerificacion : posee >

' Relaciones principales
Profesor "0..1" -down-> "0..1" Vehiculo : tiene asignado >
Vehiculo "1" -right-> "0..*" IncidenciaVehiculo : sufre >
Profesor "0..1" -right-> "0..*" IncidenciaVehiculo : reporta >

Profesor "0..1" -right-> "0..*" Alumno : enseña a >

Alumno "1" -down-> "1..*" Matricula : posee >

ClasePractica "0..*" -up-> "0..1" Alumno : recibida por >
ClasePractica "0..*" -up-> "0..1" Profesor : impartida por >

Matricula "1" -down-> "0..*" SolicitudExamen : genera >
Alumno "1" -down-> "0..*" SolicitudExamen : solicita >
Profesor "0..1" -down-> "0..*" SolicitudExamen : asignado a >
FechaExamen -[hidden]right-> CupoExamen
SolicitudExamen "1" -right-> "0..1" Examen : deriva en >
Alumno "1" -down-> "0..*" Examen : realiza >

' Separación de los Enums para evitar líneas cruzadas
Usuarios -[hidden]right-> Enums

@enduml
