@startuml Diagrama_Clases_v1
' --- AJUSTES VISUALES ---
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
skinparam padding 5

' --- 1. ENUMS (Agrupados en una esquina) ---
package "Usuarios"
{
  enum TipoCarnet
  {
    - Permiso AM // Ciclomotores
    - Permiso A1 // Motocicletas de hasta 125cc
    - Permiso A2 // Motocicletas de hasta 35kW
    - Permiso A // Motocicletas de potencia ilimitada
    - Permiso B // Automóviles
    - Permiso B+E // Automóviles con remolque
    - Permiso B1 // Cuadriciclos y triciclos
    - Permiso C // Camiones
    - Permiso C+E // Camiones con remolque
    - Permiso D // Autobuses
    - Permiso D+E // Autobuses con remolque
    - Permiso LVA // Licencia de Vehículos Agrícolas
  }

  enum EstadoUsuario
  {
    - Activo
    - Inactivo
    - Suspendido
  }

  ' --- 2. DEFINICIÓN DE CLASES ---
  abstract class Persona
  {
    - id: Long
    - nombre: String
    - apellidos: String
    - dni: String
    - fechaNacimiento: Date
    - correo: String
    - password: String
    - telefono: String
    - domicilio: String
    - rol: Rol
    - estado: EstadoUsuario
  }

  enum TipoTurno
  {
    - Mañana
    - Tarde
  }

  class Profesor
  {
    - fechaContratacion: LocalDate
    - listaAlumnos: List<Alumno>
    - listaSolicitudesExamen: List<SolicitudExamen>
    - listaCalificacionesExamen: Map<Alumno, Float>
    - listaPermisosCarnet: List<TipoCarnet>
    - turno: TipoTurno
    + consultarCalendario(): void
    + consultarListadoAlumnos(): List<Alumno>
    + enviarCorreo(destinatario: String, asunto: String, mensaje: String): void
    + consultarSolicitudesExamen(): List<SolicitudExamen>
    + establecerFechaExamen(dni: String, fecha: LocalDate): void
    + asignarCalificacionExamen(alumno: Alumno, calificacion: Float): void
  }

  class Alumno
  {
    - fechaMatriculacion: LocalDate
    - saldoClases: Integer
    - vehiculoAsignado: Vehiculo
    - permisoCarnet: TipoCarnet
    - historialClases: List<Clase>
    - convocatoriasGastadas: Integer
    - historialClases: List<Clase>
    - historialExamenes: List<Examen>
    - listaSolicitudesExamen: List<SolicitudExamen>
    - examenAprobado: Boolean
    + pagarMatricula(): Boolean
    + consultarConvocatoriasGastadas(): Integer
    + consultarSaldoClases(): Integer
    + solicitarClase(): void
    + comprarClases(cantidad: Integer): void
    + consultarHistorialClases(): List<Clase>
    + solicitarFechaExamen(): LocalDate
    + pagarExamen(): Boolean
    + consultarHistorialExamenes(): List<Examen>
    + consultarVehiculoAsignado(): Vehiculo
    + consultarCalificacionExamen(examen: Examen): Float
    + consultarEstadisticas(): void
    + estaAprobado(): Boolean
  }

  class Administrador
  {
    + crearUsuario(): void
    + eliminarUsuario(): void
    + modificarUsuario(): void
    + consultarUsuarios(): List<Persona>
    + asignarRol(): void
    + modificarEstadoUsuario(): void
    + crearProfesor(): void
    + eliminarProfesor(): void
    + modificarProfesor(): void
    + consultarProfesores(): List<Profesor>
    + crearAlumno(): void
    + eliminarAlumno(): void
    + modificarAlumno(): void
    + consultarAlumnos(): List<Alumno>
    + insertarVehiculo(): void
    + eliminarVehiculo(): void
    + modificarVehiculo(): void
    + consultarVehiculos(): List<Vehiculo>
    + consultarEstadisticas(): void
  }
}

package "Prueba"
{
  enum EstadoMatricula
  {
    - Activa
    - Inactiva
  }

  class Matricula
  {
    - id: Long
    - fechaMatriculacion: LocalDate
    - tipoCarnet: TipoCarnet
    - estado: EstadoMatricula
    - saldoClases: Integer
    + incrementarSaldo(cantidad: Integer): void
    + deducirSaldo(): Boolean
    + estaActiva(): Boolean
  }

  class Vehiculo
  {
    - id: Long
    - matricula: String
    - modelo: String
    - tipoCarnetAsociado: TipoCarnet
  }

  class Clase
  {
    - id: Long
    - fecha: LocalDate
    - hora: LocalTime
    - duracion: Integer
    - profesor: Profesor
    - alumno: Alumno
    - confirmacionProfesor: Boolean
    - confirmacionAlumno: Boolean
    - estado: EstadoClase
  }

  class Examen
  {
    - id: Long
    - fecha: LocalDate
    - hora: LocalTime
    - duracion: Integer
    - calificacion: Float
  }

  class SolicitudExamen
  {
    - id: Long
    - fechaSolicitud: LocalDate
    - estado: EstadoSolicitudExamen
  }

}

' --- 3. CONSTRUCCIÓN ESPACIAL (EL DIAMANTE) ---
Persona <|-left- Alumno
Persona <|-right- Profesor
Persona <|-down- Administrador

Cita "0..*" -left- "1" Paciente : pertenece a
Cita "0..*" -right- "1" Sanitario : atendida por
Persona -[hidden]down- Cita

' --- 4. ORGANIZACIÓN Y CITAS (Centro y Derecha) ---
CentroSanitario "1" *-up- "1..*" Sanitario : emplea
Cita "0..*" -down- "1" CentroSanitario : ocurre en

ControladorCita "1" -up- "0..*" Cita : gestiona
ControladorCita .left. Paciente : usa

' --- 5. HISTORIAL CLÍNICO Y LÓGICA MÉDICA (Ala Izquierda) ---
Paciente "1" -left- "1" HistorialClinico : posee
HistorialClinico "1" *-down- "0..*" SeguimientoMedico : contiene
HistorialClinico "1" *-up- "0..*" Tratamiento : contiene

ControladorSeguimientoMedico "1" -up- "0..*" SeguimientoMedico : gestiona
SeguimientoMedico "0..*" -up- "1..*" Tratamiento : evalúa
Tratamiento "1..*" -up- "1..*" Medicamento : receta
Tratamiento "0..*" -right- "1" Sanitario : prescrito por

' --- 6. CONTROLADORES PERIFÉRICOS (Dependencias punteadas) ---
ControladorAutenticacion .down. Paciente : valida
ControladorSeguimientoMedico .right. Paciente : usa

Persona -[hidden]right- ControladorCentroProfesional
ControladorCentroProfesional .down. Sanitario : consulta/asigna
ControladorCentroProfesional .down. CentroSanitario : consulta
ControladorCentroProfesional .left. Paciente : usa

' --- RELACIONES AÑADIDAS RECIENTEMENTE ---
' Los nuevos controladores necesitan usar al paciente para obtener/modificar sus datos
ControladorDatosPersonales .left. Paciente : usa
ControladorTramites .down. Paciente : usa

' Relación de las vacunas
Paciente "1" -left- "0..*" Vacuna : tiene

' El Controlador de Documentación es usado como una "herramienta" por los demás controladores
ControladorSeguimientoMedico .left. ServicioDocumentacion : usa
ControladorCita .down. ServicioDocumentacion : usa
ControladorDatosPersonales .up. ServicioDocumentacion : usa

@enduml