@startuml Diagrama_CU_v2
left to right direction

' --- ACTORES ---
actor "Persona" as P
actor "Administrador" as Admin
actor "Profesor" as Prof
actor "Alumno" as Alum

actor "Stripe" as Stripe << Pasarela de Pago >>
actor "Sistema de Correo" as Correo << Sistema Externo >>
actor "Portal DGT" as DGT << Sistema Externo >>
actor "Sistema Automático" as Sys << Trigger/Cron >>

' --- GENERALIZACIÓN DE ROLES ---
P <|-- Admin
P <|-- Prof
P <|-- Alum

' --- CASOS DE USO GENERALES (PERSONA) ---
package "Gestión de Acceso Común" {
  usecase "Iniciar Sesión (Usuario/Correo y Contraseña)" as UC_Login
  usecase "Recuperar Contraseña" as UC_Recuperar
}
P --> UC_Login
P --> UC_Recuperar

' --- CASOS DE USO ADMINISTRADOR ---
package "Módulo Administrador" {
  usecase "Gestionar Flota de Vehículos (CRUD)" as UC_A_Vehiculos
  usecase "Gestionar Profesores (CRUD)" as UC_A_Profesores
  usecase "Dar de Baja Profesor" as UC_A_BajaProfesor
  usecase "Eliminar Alumnos y Clases Futuras Asociadas" as UC_A_CascadaProfesor
  usecase "Gestionar Alumnos (CRUD)" as UC_A_Alumnos
  usecase "Ver Estadísticas Globales" as UC_A_Stats
  usecase "Gestionar Documentos" as UC_A_Docs
  usecase "Ver Finanzas (Gastos vs Ingresos)" as UC_A_Finanzas
}
Admin --> UC_A_Vehiculos
Admin --> UC_A_Profesores
Admin --> UC_A_Alumnos
Admin --> UC_A_Stats
Admin --> UC_A_Docs
Admin --> UC_A_Finanzas

' Relaciones Administrador
UC_A_Profesores <.. UC_A_BajaProfesor : <<extend>>
UC_A_BajaProfesor ..> UC_A_CascadaProfesor : <<include>>

' --- CASOS DE USO PROFESOR ---
package "Módulo Profesor" {
  usecase "Establecer Credenciales Iniciales" as UC_P_Alta
  usecase "Gestionar Calendario Clases (CRUD)" as UC_P_Calendario
  usecase "Modificar o Eliminar Clase" as UC_P_ModClase
  usecase "Notificar al Alumno por Correo" as UC_P_AvisoCorreo
  
  usecase "Rellenar Formulario de Clase Realizada" as UC_P_DetallesClase
  usecase "Gestionar Solicitudes de Examen" as UC_P_SolExamen
  usecase "Aceptar y Calendarizar Examen" as UC_P_AceptarExamen
  usecase "Cancelar Clases del Vehículo ese Día" as UC_P_BloqueoVehiculo
  usecase "Rechazar Solicitud de Examen" as UC_P_RechazarExamen
  usecase "Añadir Comentario de Justificación" as UC_P_JustificarExamen
  
  usecase "Calificar Examen de Alumno" as UC_P_Calificar
  usecase "Ver Estadísticas Locales" as UC_P_Stats
  usecase "Enviar Mensaje de Difusión (Día)" as UC_P_Difusion
  usecase "Reportar Incidencia Vehículo" as UC_P_Incidencia
  usecase "Recibir Avisos de Mantenimiento" as UC_P_AvisoMant
}

Prof --> UC_P_Alta
Prof --> UC_P_Calendario
Prof --> UC_P_DetallesClase
Prof --> UC_P_SolExamen
Prof --> UC_P_Calificar
Prof --> UC_P_Stats
Prof --> UC_P_Difusion
Prof --> UC_P_Incidencia

' Relaciones Profesor
Sys --> UC_P_AvisoMant : Activa
UC_P_AvisoMant --> Correo

UC_P_Calendario <.. UC_P_ModClase : <<extend>>
UC_P_ModClase ..> UC_P_AvisoCorreo : <<include>>

UC_P_SolExamen <.. UC_P_AceptarExamen : <<extend>>
UC_P_SolExamen <.. UC_P_RechazarExamen : <<extend>>

UC_P_AceptarExamen ..> UC_P_AvisoCorreo : <<include>>
UC_P_AceptarExamen ..> UC_P_BloqueoVehiculo : <<include>>
UC_P_RechazarExamen ..> UC_P_JustificarExamen : <<include>>

UC_P_Alta --> Correo
UC_P_AvisoCorreo --> Correo
UC_P_Difusion --> Correo

Admin --> UC_P_Incidencia : Visualiza también

' --- CASOS DE USO ALUMNO ---
package "Módulo Alumno" {
  usecase "Gestionar Datos Personales (CRUD)" as UC_AL_Datos
  usecase "Pagar Matriculación (Nueva o Renovación)" as UC_AL_Matricula
  usecase "Comprar Clases / Bonos" as UC_AL_ComprarClases
  usecase "Reservar Clase Práctica" as UC_AL_Reservar
  usecase "Confirmar Clases Pendientes" as UC_AL_Confirmar
  usecase "Ver Histórico de Clases" as UC_AL_Historial
  usecase "Consultar Notas de Examen" as UC_AL_Notas
  usecase "Ver Estadísticas Locales" as UC_AL_Stats
  usecase "Solicitar Fecha de Examen (Teo/Prac)" as UC_AL_SolExamen
  usecase "Pagar Tasas de Examen" as UC_AL_PagarTasas
  usecase "Solicitar Traspaso de Autoescuela" as UC_AL_Traspaso
  usecase "Bloquear Usuario (Inactivo)" as UC_AL_Bloquear
  usecase "Solicitar Clases de Iniciación" as UC_AL_Iniciacion
}

Alum --> UC_AL_Datos
Alum --> UC_AL_Matricula
Alum --> UC_AL_ComprarClases
Alum --> UC_AL_Reservar
Alum --> UC_AL_Confirmar
Alum --> UC_AL_Historial
Alum --> UC_AL_Notas
Alum --> UC_AL_Stats
Alum --> UC_AL_SolExamen
Alum --> UC_AL_Traspaso
Alum --> UC_AL_Iniciacion

' Relaciones Alumno
UC_AL_Matricula --> Stripe
UC_AL_ComprarClases --> Stripe
UC_AL_PagarTasas --> Stripe
UC_AL_Notas --> DGT

UC_AL_SolExamen ..> UC_AL_PagarTasas : <<include>>
UC_AL_Traspaso ..> UC_AL_Bloquear : <<include>>
UC_AL_Traspaso ..> UC_P_AvisoCorreo : <<include>> 
' Reutilizando el caso de uso de aviso por correo para notificar al alumno de su baja


@enduml