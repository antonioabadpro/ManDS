{
    "name": "mands-frontend",
    "version": "1.0.0",
    "description": "Herramientas de optimización y compilación de frontend para ManDS",
    "private": true,
    "scripts": {
        "build:css": "tailwindcss -i ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/tailwind.min.css --minify",
        "watch:css": "tailwindcss -i ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/tailwind.min.css --watch"
    },
    "devDependencies": {
        "@fontsource/inter": "^5.1.0",
        "htmx.org": "^1.9.12",
        "tailwindcss": "^3.4.17"
    }
}
